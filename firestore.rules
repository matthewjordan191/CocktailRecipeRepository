rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user sync data (favorites + inventory). Owner-only.
    // The app only uses users/{uid}/data/sync, but all docs under a
    // user's data subcollection are scoped to that user.
    match /users/{uid}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Community ratings: one vote per user per cocktail, keyed by uid so a
    // user can never hold more than one vote. Readable by any signed-in
    // user (the whole app is gated behind sign-in).
    match /ratings/{slug}/votes/{voteId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == voteId
        && request.resource.data.keys().hasOnly(['rating'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow delete: if request.auth != null && request.auth.uid == voteId;
    }

    // Everything else is denied by default.
  }
}
